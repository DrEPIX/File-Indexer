PYTHON_VERSION=3.12
MEDIAENGINE_UID=1000
MEDIAENGINE_GID=1000
MEDIAENGINE_PORT=8420
MEDIAENGINE_LIBRARY_PATH=../library
# Required: generate with the command in docker/README.md. Minimum 16 characters.
MEDIAENGINE_AUTH_TOKEN=
# Optional shared secret for engine-to-CLIP requests.
CLIP_AUTH_TOKEN=
# Optional shared secret for engine-to-face/object analyzer requests.
VISION_AUTH_TOKEN=
# Low-context tuning knobs for the optional face/object analyzer.
VISION_FACE_THRESHOLD=0.90
VISION_OBJECT_THRESHOLD=0.70
VISION_MAX_FACES=32
VISION_MAX_OBJECTS=100
VISION_MAX_KEYFRAMES=3
# torchvision | caffe | both. Multi-model config lives inside the vision
# model volume, for example /models/caffe/models.json.
VISION_OBJECT_BACKEND=torchvision
VISION_CAFFE_MODELS_PATH=../models/caffe
VISION_CAFFE_MODELS_CONFIG=/models/caffe/models.json
# Optional shared secret and sensitivity controls for local safety analysis.
SAFETY_AUTH_TOKEN=
SAFETY_MODEL_ID=Falconsai/nsfw_image_detection
SAFETY_REVIEW_THRESHOLD=0.45
SAFETY_FLAG_THRESHOLD=0.75
SAFETY_MAX_KEYFRAMES=12
